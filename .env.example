# Copy to .env.local. Never commit real credentials.
# Exact browser origin. Spotify requires a loopback IP or HTTPS, not localhost.
APP_URL=http://127.0.0.1:3000
# Create the database first, then use its PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/Event_ticketing# Isolated database for tests; do not point this at production dat
DATABASE_POOL_SIZE=10
# Set false BEFORE first startup with a fresh production database.
SEED_DEMO=true

# Required to send verification and password-recovery emails.
# Account creation stays available while email delivery is being configured.
# EMAIL_FROM must use a sending domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM="Evently <hello@your-domain.com>"
EMAIL_DELIVERY=resend

# Local development only: set EMAIL_DELIVERY=preview to write emails to private
# data/mail-preview/*.json instead of sending. It never bypasses verification.
# Production builds only allow preview mail on loopback with EVENTLY_TEST_MODE=true.
# Never enable test mode on a deployment.
EVENTLY_TEST_MODE=false
EMAIL_PREVIEW_DIR=./data/mail-preview

# Encryption for music authorization tokens: generate 32 random bytes, base64.
# Keep this key stable and secret. Rotating it requires reconnecting music accounts.
MUSIC_ENCRYPTION_KEY=

# Local sign-in and playlist-listing test only; requires a loopback-IP APP_URL.
# This does not enable imports or event recommendations.
SPOTIFY_CONNECTION_TEST=false
# Enable recommendations only after approval for the specific use case.
# This setting does not request or establish Spotify approval.
SPOTIFY_APPROVED_USE_CASE=false
SPOTIFY_CLIENT_ID=

# Apple Developer account, MusicKit identifier/key, and registered web origin.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Quoted PEM, using literal \n between lines. Never prefix keys with NEXT_PUBLIC_.
APPLE_MUSIC_PRIVATE_KEY=

# Stripe test keys first. Webhook listens to CONNECTED ACCOUNT events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
