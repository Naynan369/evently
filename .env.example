# Copy to .env.local. Never commit real credentials.
# Exact browser origin. Spotify requires a loopback IP or HTTPS, not localhost.
APP_URL=http://127.0.0.1:3000
# Google OAuth web client. Register APP_URL/api/auth/oauth/google/callback as
# an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple requires an HTTPS APP_URL, a Services ID, a Sign in with
# Apple key, and APP_URL/api/auth/oauth/apple/callback as a return URL.
# These are separate from the Apple Music credentials below.
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
# Create the database first, then use its PostgreSQL connection string.
# For Neon on Vercel, use the pooled URL (its host contains "-pooler").
# Keep the actual URL private in .env.local and the Vercel environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_SIZE=5
# Fictional example listings are available in local development and isolated tests when enabled.
# Keep false for a Messina launch. Existing samples in a database are hidden in production.
SEED_DEMO=false
# Private organizer trial: new events stay drafts, Stripe is hidden/disabled,
# and organizers can create practice guests and send feedback.
EVENTLY_ORGANIZER_DEMO=false

# Gmail SMTP account used for verification codes and password-reset links.
# MYPASS is a Google app password. Keep both values server-side.
MYEMAIL=
MYPASS=
EMAIL_DELIVERY=gmail

# Local development only: set EMAIL_DELIVERY=preview to write emails to private
# data/mail-preview/*.json instead of sending. It never bypasses verification.
# Production builds only allow preview mail on loopback with EVENTLY_TEST_MODE=true.
# Never enable test mode on a deployment.
EVENTLY_TEST_MODE=false
EMAIL_PREVIEW_DIR=./data/mail-preview

# Encryption for music authorization tokens: generate 32 random bytes, base64.
# Keep this key stable and secret. Rotating it requires reconnecting music accounts.
MUSIC_ENCRYPTION_KEY=

# Local sign-in and playlist-listing test only; requires a loopback-IP APP_URL.
# This does not enable imports or event recommendations.
SPOTIFY_CONNECTION_TEST=false
# Enable recommendations only after approval for the specific use case.
# This setting does not request or establish Spotify approval.
SPOTIFY_APPROVED_USE_CASE=false
SPOTIFY_CLIENT_ID=

# Apple Developer account, MusicKit identifier/key, and registered web origin.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Quoted PEM, using literal \n between lines. Never prefix keys with NEXT_PUBLIC_.
APPLE_MUSIC_PRIVATE_KEY=

# Stripe test keys first. A webhook is optional for Checkout return-page reconciliation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
